{
  "name": "ktx2-vram-measurement",
  "version": "1.0.0",
  "description": "Measuring actual GPU VRAM usage of compressed textures: block alignment, mipchain overhead, cubemap multiplier, KTX2 transcoding targets, and compressedTexImage2D probes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "predev": "npm run prepare-basis",
    "build": "tsc && vite build",
    "prebuild": "npm run prepare-basis",
    "preview": "vite preview",
    "prepare-basis": "node scripts/copy-basis.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
